	"Z": ["11111", "00011", "00110", "00100", "01100", "11000", "11111"],
}
var text := "CAFFEINE\nPROTOCOL"
var pixel_size := 5
var color := Color("f3ce91")

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	var lines := text.split("\n")
	var widest := 0
	for line in lines:
		widest = maxi(widest, line.length())
	custom_minimum_size = Vector2(widest * 6 * pixel_size, lines.size() * 10 * pixel_size)

func _draw() -> void:
	var y := 0
	for line in text.split("\n"):
		var x := 0
		for character in line:
			if GLYPHS.has(character):
				var pattern: Array = GLYPHS[character]
				for row in range(7):
					for col in range(5):
						if pattern[row][col] == "1":
							var rect := Rect2((x + col) * pixel_size, (y + row) * pixel_size, pixel_size, pixel_size)
							draw_rect(Rect2(rect.position + Vector2(0, pixel_size), rect.size), Color("654d47"))
							draw_rect(rect, color if row < 5 else color.darkened(0.12))
			x += 6
		y += 10
